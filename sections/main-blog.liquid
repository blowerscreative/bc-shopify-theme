{%- paginate blog.articles by 9 -%}
<section class="section"><div class="wrap">
  <div class="eyebrow">Journal</div><h1>{{ blog.title }}</h1>
  <div class="grid" style="--cols:3;margin-top:2rem">
  {%- for article in blog.articles -%}
    <a class="card" href="{{ article.url }}">
      <div class="card__media" style="aspect-ratio:3/2">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}<div class="card__placeholder">{% render 'mark', size: 60 %}</div>{%- endif -%}</div>
      <div class="card__body" style="display:block"><div class="article-meta">{{ article.published_at | date: '%b %d, %Y' }}</div><h3 class="card__title">{{ article.title }}</h3><p class="dim" style="font-size:.85rem">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p></div>
    </a>
  {%- else -%}<p class="dim">No posts yet.</p>
  {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
</div></section>
{%- endpaginate -%}
{% schema %}
{"name": "Blog", "settings": []}
{% endschema %}
