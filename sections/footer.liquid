<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <a class="brand" href="{{ routes.root_url }}">{% render 'mark', size: 22 %}<span class="brand__name">{{ shop.name }}</span></a>
        <p class="footer__tag">{{ section.settings.tagline }}</p>
        {%- if section.settings.show_signup -%}
          {%- form 'customer', id: 'footer-signup' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}<p class="form-msg form-msg--ok">You're on the list. We'll keep it short.</p>{%- endif -%}
            <label class="label" for="footer-email">News and promotions</label>
            <div class="signup">
              <input id="footer-email" type="email" name="contact[email]" placeholder="you@example.com" required autocomplete="email">
              <button type="submit">Sign up →</button>
            </div>
          {%- endform -%}
        {%- endif -%}
      </div>
      <div>
        <div class="label" style="margin-bottom:1rem">{{ section.settings.menu_1.title | default: 'Shop' }}</div>
        <ul>{%- for link in section.settings.menu_1.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
      </div>
      <div>
        <div class="label" style="margin-bottom:1rem">{{ section.settings.menu_2.title | default: 'Info' }}</div>
        <ul>{%- for link in section.settings.menu_2.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
      </div>
    </div>
    <div class="footer__base">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.location }}</span>
      {%- if section.settings.base_note != blank -%}<span>{{ section.settings.base_note | escape }}</span>{%- endif -%}
      <blowers-badge theme="dark"></blowers-badge>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The Straightforward Creative Company™" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email sign-up", "default": true },
    { "type": "link_list", "id": "menu_1", "label": "Menu 1", "default": "main-menu" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2", "default": "footer" },
    { "type": "text", "id": "location", "label": "Location line", "default": "Springfield, Missouri." },
    { "type": "text", "id": "base_note", "label": "Bottom note" }
  ]
}
{% endschema %}
