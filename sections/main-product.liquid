{%- assign current = product.selected_or_first_available_variant -%}
<section class="section">
  <div class="wrap">
    <nav class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif %}{{ product.title }}</nav>
    <div class="product">
      <div class="product__gallery">
        {%- for media in product.media -%}
          <figure>{%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}{{ media | image_url: width: 1600 | image_tag: loading: ld, sizes: '(min-width: 860px) 55vw, 100vw', widths: '600, 900, 1200, 1600' }}</figure>
        {%- else -%}
          <figure class="card__media"><div class="card__placeholder">{% render 'mark', size: 160 %}</div></figure>
        {%- endfor -%}
      </div>
      <div class="product__info">
        {%- if product.vendor != blank and section.settings.show_vendor -%}<div class="eyebrow">{{ product.vendor }}</div>{%- endif -%}
        <h1>{{ product.title }}</h1>
        <div class="product__price">{% render 'price', product: product, variant: current, data_attr: true %}</div>
        {% render 'bogo-offer', product: product %}
        {%- form 'product', product, class: 'product__form' -%}
          {{ form.errors | default_errors }}
          <input type="hidden" name="id" value="{{ current.id }}">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="field">
                <label for="opt-{{ forloop.index }}">{{ option.name }}</label>
                <select id="opt-{{ forloop.index }}" data-option>
                  {%- for value in option.values -%}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          <label class="label" for="qty">Quantity</label>
          <div class="buy-row">
            <div class="qty" data-qty><button type="button" data-step="down" aria-label="Decrease">−</button><input id="qty" type="number" name="quantity" value="1" min="1"><button type="button" data-step="up" aria-label="Increase">+</button></div>
            <button type="submit" class="btn" data-add data-label="Add to cart" data-soldout="Sold out" data-unavailable="Unavailable" {% unless current.available %}disabled{% endunless %}>
              {%- if current.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
          </div>
          {%- if section.settings.dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
        {%- endform -%}
        {% render 'purchase-trust' %}
        <div class="rte">{{ product.description }}</div>
        {%- if section.settings.straight_title != blank -%}
          <div class="straight">
            <div class="label">{{ section.settings.straight_title }}</div>
            {{ section.settings.straight_text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  <script type="application/json" data-product-json>{"variants":[{%- for v in product.variants -%}{"id":{{ v.id }},"available":{{ v.available }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"options":{{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
</section>
{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
    { "type": "text", "id": "straight_title", "label": "Straight-answer box title", "default": "The straight answer" },
    { "type": "richtext", "id": "straight_text", "label": "Straight-answer box text", "default": "<ul><li>Price shown is the price you pay before shipping and tax.</li><li>Shipping cost is shown at checkout before you pay.</li><li>Questions? Email us and a person replies.</li></ul>" }
  ]
}
{% endschema %}
