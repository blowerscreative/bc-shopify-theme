{%- assign col = section.settings.collection -%}
<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="wrap">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <a class="link-arrow" href="{{ col.url | default: routes.all_products_collection_url }}">View all</a>
    </div>
    <div class="grid" style="--cols: {{ section.settings.columns }}">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- elsif collections.all.products_count > 0 -%}
        {%- for product in collections.all.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}{% render 'product-card', product: blank %}{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be used." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "alt", "label": "Alternate background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
