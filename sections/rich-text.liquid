<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="wrap narrow {% if section.settings.center %}center{% endif %}" style="{% if section.settings.center %}margin:0 auto{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte lede dim" style="{% if section.settings.center %}margin:0 auto 1.5rem{% endif %}">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.button_link | default: '/pages/contact' }}">{{ section.settings.button_label }} →</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ask a question, get a straight answer." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Not sure which size, finish, or option is right? Email us and a real person will reply.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "center", "label": "Center", "default": true },
    { "type": "checkbox", "id": "alt", "label": "Alternate background", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
