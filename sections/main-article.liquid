<article class="section"><div class="wrap narrow">
  <nav class="breadcrumbs"><a href="{{ blog.url }}">{{ blog.title }}</a></nav>
  <div class="article-meta">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</div>
  <h1 style="margin-top:.75rem">{{ article.title }}</h1>
  {%- if article.image -%}<figure style="margin:2rem 0">{{ article.image | image_url: width: 1600 | image_tag: alt: article.title }}</figure>{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</div></article>
{% schema %}
{"name": "Article", "settings": []}
{% endschema %}
