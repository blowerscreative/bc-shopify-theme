<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: section.settings.image.alt }}</div>
  {%- endif -%}
  <div class="hero__mark" aria-hidden="true">{% render 'mark', size: 560 %}</div>
  <div class="wrap hero__inner">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading_1 }} <em>{{ section.settings.heading_accent }}</em><br>{{ section.settings.heading_2 }}{% if section.settings.tm %}<sup>™</sup>{% endif %}</h1>
    <div class="lede">{{ section.settings.text }}</div>
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} →</a>{%- endif -%}
      {%- if section.settings.button_2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.button_2_link | default: 'https://blowerscreative.com' }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The shop · Springfield, MO" },
    { "type": "text", "id": "heading_1", "label": "Heading start", "default": "The" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (amber italic)", "default": "Straightforward" },
    { "type": "text", "id": "heading_2", "label": "Heading end", "default": "Creative Shop" },
    { "type": "checkbox", "id": "tm", "label": "Show ™", "default": true },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Goods made by the people behind Blowers Creative. Clear prices, honest descriptions, and a straight answer if you ask a question.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop everything" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Our approach" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
