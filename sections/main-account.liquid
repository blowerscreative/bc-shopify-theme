<section class="section"><div class="wrap">
  <div class="section-head"><div><div class="eyebrow">Account</div><h1 class="h2">Hi, {{ customer.first_name | default: 'there' }}.</h1></div><a class="link-arrow" href="{{ routes.account_logout_url }}">Log out</a></div>
  <div class="split" style="align-items:start">
    <div><h2 class="h3">Orders</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <table class="cart-table"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th style="text-align:right">Total</th></tr></thead><tbody>
        {%- for order in customer.orders -%}<tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%b %d, %Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td style="text-align:right">{{ order.total_price | money }}</td></tr>{%- endfor -%}
        </tbody></table>
      {%- else -%}<p class="dim">No orders yet.</p>{%- endif -%}
    {%- endpaginate -%}</div>
    <div class="panel"><h2 class="h3">Default address</h2>{{ customer.default_address | format_address }}<a class="link-arrow" href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a></div>
  </div>
</div></section>
{% schema %}
{"name": "Account", "settings": []}
{% endschema %}
