<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'blowers-mark.svg' | asset_url }}">
  {%- endif -%}
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: {{ settings.color_ink }};
      --ink-2: {{ settings.color_ink_2 }};
      --bone: {{ settings.color_bone }};
      --bone-dim: {{ settings.color_bone_dim }};
      --amber: {{ settings.color_amber }};
      --amber-soft: {{ settings.color_amber_soft }};
      --on-amber: {{ settings.color_ink }};
      --line: rgba(243, 239, 228, 0.12);
      --serif: "Fraunces", Georgia, "Times New Roman", serif;
      --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
      --pad: clamp(1.25rem, 5vw, 5rem);
      --max: {{ settings.page_width }}px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip" href="#main">Skip to content</a>
  {% section 'announcement' %}
  {% section 'header' %}
  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'blowers-badge.js' | asset_url }}" defer></script>
</body>
</html>
