<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} &ndash; Opening soon</title>
  <link rel="icon" type="image/svg+xml" href="{{ 'blowers-mark.svg' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root { --ink: {{ settings.color_ink }}; --ink-2: {{ settings.color_ink_2 }}; --bone: {{ settings.color_bone }}; --bone-dim: {{ settings.color_bone_dim }}; --amber: {{ settings.color_amber }}; --amber-soft: {{ settings.color_amber_soft }}; --on-amber: {{ settings.color_ink }}; --line: rgba(243,239,228,.12); --serif: "Fraunces", Georgia, serif; --mono: "IBM Plex Mono", ui-monospace, monospace; --pad: clamp(1.25rem,5vw,5rem); --max: {{ settings.page_width }}px; }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
